# ---------------------------------------------------------------------------
# AI-Powered Data Analyst — Environment Variable Reference
# Copy this file to .env and fill in the values before running the app.
# NEVER commit your .env file to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------

# API key for the LLM provider.
# OpenAI:  obtain from https://platform.openai.com/api-keys
# Groq:    obtain from https://console.groq.com  (free tier available)
# Gemini:  obtain from https://aistudio.google.com  (free tier available)
OPENAI_API_KEY=your-api-key-here

# LLM model name.
# Default (OpenAI GPT-4o — final submission):
LLM_MODEL=gpt-4o
# Groq local testing alternative (uncomment and comment the line above):
# LLM_MODEL=llama-3.3-70b-versatile

# LLM provider base URL.
# Leave unset (or blank) to use the OpenAI default endpoint.
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------

# Application environment. One of: development | production | test
APP_ENV=development

# Maximum allowed CSV upload size in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Maximum number of conversation exchanges retained per session.
MAX_HISTORY_EXCHANGES=20
